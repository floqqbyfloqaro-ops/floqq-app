{
  "expo": {
    "name": "floqq-app",
    "slug": "floqq-app",
    "version": "1.0.0",
    "scheme": "floqq",
    "orientation": "portrait",
    "icon": "./assets/icon-full.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.floqq.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/icon-adaptive-fg.png",
        "monochromeImage": "./assets/icon-mono.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.floqq.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FLOQQ uses your location so you and your taxi group can find each other at the airport. It is only shared with your group, and only while you choose to."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": [],
          "enableGooglePay": true
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "FLOQQ uses your camera so you can photograph the taxi receipt after your ride, and so staff can photograph airport meeting points.",
          "microphonePermission": false
        }
      ]
    ],
    "owner": "floqq",
    "extra": {
      "eas": {
        "projectId": "a58a76e1-b378-4dc4-9644-502927fda7ac"
      }
    }
  }
}
